config pbr 'config'
	option enabled '1'

config policy
	option name 'Steam game ports'
	option interface 'wan_sla'
	option proto 'tcp udp'
	option dest_port '27000-27100'

config policy
	option name 'Steam service domains'
	option interface 'wan_sla'
	list dest_addr 'steampowered.com'
	list dest_addr 'steamcontent.com'

config policy
	option name 'Gaming PC preferred SLA'
